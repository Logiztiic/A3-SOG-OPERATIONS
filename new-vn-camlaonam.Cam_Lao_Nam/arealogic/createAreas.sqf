fnc_createZoneMarkers = {
    private _markerList = [];
    private _zonePool = missionNamespace getVariable ["fob_zonePool", []];

    diag_log format ["DEBUG: Zone pool contains %1 zones", count _zonePool];

    {
        private _zoneID  = _x select 0;
        private _center  = _x select 1;
        private _width   = _x select 2;
        private _height  = _x select 3;

        private _markerName = format ["%1_marker", _zoneID];

        private _marker = createMarker [_markerName, _center];
        _marker setMarkerShape "HEXAGON";
        _marker setMarkerBrush "Solid";
        _marker setMarkerType "";
        _marker setMarkerColor "ColorRed";
        _marker setMarkerAlpha 0.95;
        _marker setMarkerSize [_width, _height];
        _marker setMarkerText format ["%1", _zoneID];

        _markerList pushBack _markerName;

    } forEach _zonePool;

    missionNamespace setVariable ["ZoneMarkerNames", _markerList];
    diag_log format ["DEBUG: Stored %1 zone markers in ZoneMarkerNames", count _markerList];
};

missionNamespace setVariable ["fnc_createZoneMarkers", fnc_createZoneMarkers];

[] remoteExec ["fnc_createZoneMarkers", 0, true];

fnc_updateZoneMarkerColor = {
    params ["_zoneID"];

    private _allMarkers = missionNamespace getVariable ["ZoneMarkerNames", []];
    private _targetName = format ["%1_marker", _zoneID];

    private _matchedMarker = "";
    {
        if (_x == _targetName) exitWith {
            _matchedMarker = _x;
        };
    } forEach _allMarkers;

    if (_matchedMarker == "") exitWith {
        diag_log format ["WARNING: Marker %1 not found in ZoneMarkerNames", _targetName];
    };

    _matchedMarker setMarkerColor "ColorGreen";
    [] call (missionNamespace getVariable "fnc_completeZone");
};

missionNamespace setVariable ["fnc_updateZoneMarkerColor", fnc_updateZoneMarkerColor];

fnc_cleanupReconMarkers = {
    params ["_zoneIDs"];

    private _zoneData = missionNamespace getVariable ["fob_zonePool", []];
    private _reconMarkers = missionNamespace getVariable ["reconMarkers", []];
    private _remainingMarkers = [];

    {
        private _markerName = _x;
        private _markerPos = getMarkerPos _markerName;
        private _shouldDelete = false;

        {
            private _zoneID = _x select 0;
            private _zonePos = _x select 1;
            private _zoneRadius = _x select 2;

            if (_zoneID in _zoneIDs && {_markerPos distance _zonePos < _zoneRadius}) exitWith {
                _shouldDelete = true;
            };
        } forEach _zoneData;

        if (_shouldDelete) then {
            deleteMarker _markerName;
        } else {
            _remainingMarkers pushBack _markerName;
        };
    } forEach _reconMarkers;

    missionNamespace setVariable ["reconMarkers", _remainingMarkers];
};

missionNamespace setVariable ["fnc_cleanupReconMarkers", fnc_cleanupReconMarkers];

fnc_checkZones = {

    if (missionNamespace getVariable ["ZoneActive", false]) exitWith {};

    private _activatedZones = missionNamespace getVariable ["ActivatedZoneIDs", []];
    diag_log format ["ActivatedZoneIDs = %1", _activatedZones];

    private _zonePool = missionNamespace getVariable ["fob_zonePool", []];

    {
        private _zoneID = _x select 0;
        private _center = _x select 1;
        private _width  = _x select 2;
        private _height = _x select 3;

        if (_zoneID in _activatedZones) then { continue };

        private _playersInZone = allPlayers select {
            private _unit = _x;
            alive _unit &&
            _unit inArea [_center, _width + 300, _height + 300, 0, false, 500]
        };

        if (count _playersInZone > 0) exitWith {

            diag_log format ["Activating zone %1", _zoneID];

            missionNamespace setVariable ["ZoneActive", true];
            missionNamespace setVariable ["ActiveZone_startTime", time];
            missionNamespace setVariable ["ActiveZoneID", _zoneID];
            missionNamespace setVariable ["ActiveZoneCenter", _center];
            missionNamespace setVariable ["ActiveZoneWidth", _width];
            missionNamespace setVariable ["ActiveZoneHeight", _height];

            _activatedZones pushBackUnique _zoneID;
            missionNamespace setVariable ["ActivatedZoneIDs", _activatedZones];

            [_activatedZones] call (missionNamespace getVariable "fnc_cleanupReconMarkers");
            [] call (missionNamespace getVariable "fnc_cleanupHarassmentUnits");
            [] call (missionNamespace getVariable "fnc_cleanupCounterattackUnits");
            [] call (missionNamespace getVariable "fnc_cleanupCounterattackUnits");
            [] call (missionNamespace getVariable "fnc_cleanupIntelDefenders");
            [] call (missionNamespace getVariable "fnc_pruneCombatUnits");

            [_center] call fnc_setupArea;
            [_center, _width, _height] call (missionNamespace getVariable "fnc_createIntelSites");
            [_center, _width, _height] call (missionNamespace getVariable "fnc_startTaskSequence");

            terminate (missionNamespace getVariable ["HarassmentThread", scriptNull]);
            missionNamespace setVariable ["HarassmentThread", nil];
            terminate (missionNamespace getVariable ["IntelDefenderThread", scriptNull]);
	    missionNamespace setVariable ["IntelDefenderThread", nil];
            terminate (missionNamespace getVariable ["SaboteurThread", scriptNull]);
	    missionNamespace setVariable ["SaboteurThread", nil];


            private _harassThread = [_center, _width, _height] spawn fnc_startHarassment;
            missionNamespace setVariable ["HarassmentThread", _harassThread];
            private _radios = missionNamespace getVariable ["ActiveIntelRadios", []];
            private _intelThread = [_radios] spawn fnc_spawnIntelDefenders;
            missionNamespace setVariable ["IntelDefenderThread", _intelThread];
            private _sabThread = [] spawn fnc_spawnSaboteurTeam;
            missionNamespace setVariable ["SaboteurThread", _sabThread];

        };

    } forEach _zonePool;
};

missionNamespace setVariable ["fnc_checkZones", fnc_checkZones];

fnc_checkZoneObjectives = {
    if (!isServer) exitWith {};

    private _completeTask = missionNamespace getVariable "fnc_completeTask";

    private _aaUnits = missionNamespace getVariable ["Active_aaUnits", []];
    private _aaCleared = false;

    if (count _aaUnits > 0) then {
        _aaCleared = { !alive _x } count _aaUnits == count _aaUnits;
        if (_aaCleared) then {
            missionNamespace setVariable ["Active_aaUnits", []];
        };
    } else {
        _aaCleared = true;
    };

    private _mortarUnits = missionNamespace getVariable ["Active_mortarUnits", []];
    private _mortarCleared = false;

    if (count _mortarUnits > 0) then {
        _mortarCleared = { !alive _x } count _mortarUnits == count _mortarUnits;
        if (_mortarCleared) then {
            missionNamespace setVariable ["Active_mortarUnits", []];
        };
    } else {
        _mortarCleared = true;
    };

    if (_aaCleared && _mortarCleared) then {
        ["task_destroySites"] call _completeTask;
    };
};

fnc_checkGameCompletion = {
    private _zonePool = missionNamespace getVariable ["fob_zonePool", []];
    private _completed = missionNamespace getVariable ["CompletedZoneIDs", []];

    private _allZoneIDs = _zonePool apply { _x select 0 };
    private _remaining = _allZoneIDs - _completed;

    if (count _remaining == 0) then {
        [] spawn {
            sleep 10;
            ["All zones secured. Mission complete."] remoteExec ["endMission", 0];
        };
    };
};

fnc_startZoneLogicThread = {
    if (!isServer) exitWith {
        diag_log "fnc_startZoneLogicThread: Called on client — exiting.";
    };

    private _oldThread = missionNamespace getVariable ["ZoneLogicThread", scriptNull];
    if (!isNull _oldThread) then {
        terminate _oldThread;
        diag_log "fnc_startZoneLogicThread: Existing thread terminated.";
    };

    private _thread = [] spawn {
        diag_log "ZoneLogicThread: Started.";
        while {true} do {
            call fnc_checkZones;
            call fnc_checkZoneObjectives;
            [] call (missionNamespace getVariable "fnc_preventZoneHang");
	    [] call fnc_checkGameCompletion;

            [] call (missionNamespace getVariable "fnc_cleanupOldBuilds");

            sleep 10;
        };
    };

    missionNamespace setVariable ["ZoneLogicThread", _thread];
};
missionNamespace setVariable ["fnc_startZoneLogicThread", fnc_startZoneLogicThread];

fnc_getOutsideZonePos = {
    params ["_center", "_width", "_height", "_distance"];

    private _a = (_width / 2) + _distance;  // semi-major axis + buffer
    private _b = (_height / 2) + _distance; // semi-minor axis + buffer

    private _attempts = 0;
    private _spawnPos = [0, 0, 0];
    private _valid = false;

    while { !_valid && _attempts < 200 } do {
        private _angle = random 360;

        private _offsetX = _a * cos _angle;
        private _offsetY = _b * sin _angle;

        _spawnPos = [ (_center select 0) + _offsetX, (_center select 1) + _offsetY, 0 ];

        private _tooClose = { _spawnPos distance _x < 385 } count (allPlayers select { alive _x }) > 0;
        private _inWater = surfaceIsWater _spawnPos;

        if (!_tooClose && !_inWater) then {
            _valid = true;
        };

        _attempts = _attempts + 1;
    };

    _spawnPos
};

missionNamespace setVariable ["fnc_getOutsideZonePos", fnc_getOutsideZonePos];
